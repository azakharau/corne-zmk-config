// Rulemak-CDH: Rulemak adapted for Colemak-DH firmware keyboards
// Russian letters are remapped so that a keyboard sending Colemak-DH
// HID scancodes produces the same physical layout as standard Rulemak.
//
// Based on Rulemak by Ghen & DreymaR (Colemak Forum)
// Adapted for Colemak-DH firmware by azakharau

partial alphanumeric_keys
xkb_symbols "rulemak_cdh" {

    name[Group1]= "Russian (Rulemak-CDH, for Colemak-DH firmware)";

    key <TLDE> { [     Cyrillic_io,     Cyrillic_IO,           U0300,           U030F ] }; // ё
    key <AE01> { [               1,          exclam,           U0301,           U030B ] }; // 1
    key <AE02> { [               2,              at,           U0308                  ] }; // 2
    key <AE03> { [               3,      numerosign,      numbersign                  ] }; // 3
    key <AE04> { [               4,          dollar,            cent                  ] }; // 4
    key <AE05> { [               5,         percent,        EuroSign                  ] }; // 5
    key <AE06> { [               6,     asciicircum,           U0306,           U0304 ] }; // 6
    key <AE07> { [               7,       ampersand                                   ] }; // 7
    key <AE08> { [               8,        asterisk,           U20BD,           U20B4 ] }; // 8
    key <AE09> { [               9,       parenleft,     bracketleft                  ] }; // 9
    key <AE10> { [               0,      parenright,    bracketright                  ] }; // 0
    key <AE11> { [           minus,      underscore,          endash,          emdash ] }; // -
    key <AE12> { [ Cyrillic_hardsign, Cyrillic_HARDSIGN,       equal,            plus ] }; // ъ

    // Alpha keys remapped for Colemak-DH firmware scancodes
    key <AD01> { [     Cyrillic_ya,     Cyrillic_YA,           U0463,           U0462 ] };
    key <AD02> { [    Cyrillic_zhe,    Cyrillic_ZHE,           U0475,           U0474 ] };
    key <AD03> { [     Cyrillic_ie,     Cyrillic_IE,    Ukrainian_ie,    Ukrainian_IE ] };
    key <AD04> { [     Cyrillic_er,     Cyrillic_ER                                   ] };
    key <AD05> { [     Cyrillic_te,     Cyrillic_TE,    Serbian_tshe,    Serbian_TSHE ] };
    key <AD06> { [   Cyrillic_yeru,   Cyrillic_YERU,    Ukrainian_yi,    Ukrainian_YI ] };
    key <AD07> { [      Cyrillic_u,      Cyrillic_U, Byelorussian_shortu, Byelorussian_SHORTU ] };
    key <AD08> { [      Cyrillic_i,      Cyrillic_I,     Ukrainian_i,     Ukrainian_I ] };
    key <AD09> { [      Cyrillic_o,      Cyrillic_O                                   ] };
    key <AD10> { [     Cyrillic_pe,     Cyrillic_PE                                   ] };
    key <AC01> { [      Cyrillic_a,      Cyrillic_A                                   ] };
    key <AC02> { [     Cyrillic_es,     Cyrillic_ES                                   ] };
    key <AC03> { [     Cyrillic_de,     Cyrillic_DE,     Serbian_dje,     Serbian_DJE ] };
    key <AC04> { [     Cyrillic_ef,     Cyrillic_EF,           U0473,           U0472 ] };
    key <AC05> { [    Cyrillic_ghe,    Cyrillic_GHE, Ukrainian_ghe_with_upturn, Ukrainian_GHE_WITH_UPTURN ] };
    key <AC06> { [     Cyrillic_che,   Cyrillic_CHE,   Cyrillic_dzhe,   Cyrillic_DZHE ] };
    key <AC07> { [ Cyrillic_shorti, Cyrillic_SHORTI,     Cyrillic_je,     Cyrillic_JE ] };
    key <AC08> { [     Cyrillic_ka,     Cyrillic_KA,   Macedonia_kje,   Macedonia_KJE ] };
    key <AC09> { [     Cyrillic_el,     Cyrillic_EL,    Cyrillic_lje,    Cyrillic_LJE ] };
    key <AC10> { [     Cyrillic_yu,     Cyrillic_YU,       semicolon,           colon ] };
    key <AB01> { [     Cyrillic_ze,     Cyrillic_ZE,   Macedonia_dse,   Macedonia_DSE ] };
    key <AB02> { [     Cyrillic_ha,     Cyrillic_HA                                   ] };
    key <AB03> { [    Cyrillic_tse,    Cyrillic_TSE                                   ] };
    key <AB04> { [     Cyrillic_ve,     Cyrillic_VE                                   ] };
    key <AB05> { [     Cyrillic_be,     Cyrillic_BE,   Macedonia_gje,   Macedonia_GJE ] };
    key <AB06> { [     Cyrillic_en,     Cyrillic_EN,    Cyrillic_nje,    Cyrillic_NJE ] };
    key <AB07> { [     Cyrillic_em,     Cyrillic_EM                                   ] };

    key <AD11> { [    Cyrillic_sha,    Cyrillic_SHA,   guillemotleft,       braceleft ] };
    key <AD12> { [  Cyrillic_shcha,  Cyrillic_SHCHA,  guillemotright,      braceright ] };
    key <BKSL> { [      Cyrillic_e,      Cyrillic_E,       backslash,             bar ] };
    key <AC11> { [ Cyrillic_softsign, Cyrillic_SOFTSIGN,  apostrophe,        quotedbl ] };
    key <AB08> { [           comma,       semicolon,            less                  ] };
    key <AB09> { [          period,           colon,         greater                  ] };
    key <AB10> { [           slash,        question,           U04CF,           U04C0 ] };
    key <LSGT> { [           equal,            plus,        multiply,        division ] };

    include "level3(ralt_switch)"
    include "capslock(backspace)"
    include "nbsp(level4)"
};
